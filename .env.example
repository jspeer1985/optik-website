# OPTIK Merchant Onboarding - Environment Variables Template
# Copy this file to .env.local and fill in your values

# ============================================
# SOLANA CONFIGURATION
# ============================================

# Network: devnet | testnet | mainnet-beta | localnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Public RPC endpoint (use one of the options below)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# ============================================
# PREMIUM RPC PROVIDERS (RECOMMENDED FOR PRODUCTION)
# Choose ONE and uncomment
# ============================================

# Option 1: Helius (https://helius.dev)
# HELIUS_API_KEY=your_helius_api_key_here
# NEXT_PUBLIC_SOLANA_RPC_URL=https://rpc.helius.xyz/?api-key=${HELIUS_API_KEY}

# Option 2: QuickNode (https://quicknode.com)
# QUICKNODE_MAINNET_URL=your_quicknode_mainnet_url_here
# QUICKNODE_DEVNET_URL=your_quicknode_devnet_url_here
# NEXT_PUBLIC_SOLANA_RPC_URL=${QUICKNODE_DEVNET_URL}

# Option 3: Alchemy (https://alchemy.com)
# ALCHEMY_API_KEY=your_alchemy_api_key_here
# NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-devnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# ============================================
# DATABASE CONFIGURATION (PRODUCTION)
# ============================================

# PostgreSQL database URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://optik_user:password@localhost:5432/optik_db

# Database pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================
# REDIS CONFIGURATION (PRODUCTION)
# ============================================

# Redis URL for caching and rate limiting
# Format: redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# Redis session TTL (seconds)
REDIS_SESSION_TTL=3600

# ============================================
# EMAIL CONFIGURATION
# ============================================

# SendGrid (recommended)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Or use SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here

# Email addresses
EMAIL_FROM=noreply@optik.io
EMAIL_SUPPORT=support@optik.io
EMAIL_ADMIN=admin@optik.io

# ============================================
# AWS CONFIGURATION (NFT METADATA STORAGE)
# ============================================

# AWS credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# S3 bucket for NFT metadata
S3_BUCKET_NAME=optik-nft-metadata

# CloudFront distribution (optional, for CDN)
CLOUDFRONT_DISTRIBUTION_ID=your_cloudfront_distribution_id_here

# ============================================
# ALTERNATIVE: ARWEAVE (PERMANENT STORAGE)
# ============================================

# Arweave wallet for permanent NFT storage
# ARWEAVE_WALLET_KEY=your_arweave_wallet_key_here

# ============================================
# ALTERNATIVE: NFT.STORAGE (FREE IPFS)
# ============================================

# NFT.Storage API token (free tier available)
# NFT_STORAGE_API_KEY=your_nft_storage_api_key_here

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development

# API rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your_session_secret_here

# ============================================
# SECURITY
# ============================================

# CSRF token secret
CSRF_SECRET=your_csrf_secret_here

# Encryption key for sensitive data
ENCRYPTION_KEY=your_encryption_key_here

# ============================================
# MONITORING & LOGGING
# ============================================

# Sentry (error tracking)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ORG=your_sentry_org_here
SENTRY_PROJECT=your_sentry_project_here

# DataDog (APM)
DD_API_KEY=your_datadog_api_key_here
DD_SITE=datadoghq.com

# LogDNA / LogRocket
LOGDNA_INGESTION_KEY=your_logdna_key_here

# ============================================
# ANALYTICS
# ============================================

# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here

# PostHog
NEXT_PUBLIC_POSTHOG_API_KEY=your_posthog_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# SOCIAL & EXTERNAL SERVICES
# ============================================

# Discord webhook for notifications
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Slack webhook
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Twitter API (for social sharing)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here

# ============================================
# PAYMENT PROCESSING (FUTURE)
# ============================================

# Stripe (for fiat payments)
# STRIPE_PUBLIC_KEY=your_stripe_public_key_here
# STRIPE_SECRET_KEY=your_stripe_secret_key_here
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/disable features
FEATURE_FLAG_MERCHANT_ONBOARDING=true
FEATURE_FLAG_NFT_MINTING=true
FEATURE_FLAG_STAKING=true
FEATURE_FLAG_GOVERNANCE=false

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Enable debug mode
DEBUG=false

# Enable verbose logging
VERBOSE_LOGGING=false

# Skip email sending (for development)
SKIP_EMAIL_SEND=true

# Mock Solana transactions (for development)
MOCK_SOLANA_TRANSACTIONS=true

# ============================================
# PRODUCTION CHECKLIST
# ============================================

# Before deploying to production, ensure:
# [ ] NODE_ENV=production
# [ ] Strong SESSION_SECRET generated
# [ ] Production RPC endpoint configured (Helius/QuickNode)
# [ ] Database credentials secured
# [ ] Email service configured and tested
# [ ] S3/Arweave configured for metadata storage
# [ ] Monitoring services enabled (Sentry, DataDog)
# [ ] Analytics configured
# [ ] Feature flags reviewed
# [ ] All secrets stored in secure vault (AWS Secrets Manager, Vault, etc.)
# [ ] Environment variables never committed to git

# ============================================
# NOTES
# ============================================

# 1. Copy this file: cp .env.example .env.local
# 2. Never commit .env.local to version control
# 3. Use different values for dev/staging/production
# 4. Rotate secrets regularly
# 5. Use environment-specific RPC endpoints
# 6. Keep this template updated when adding new env vars
